{
  "id": "claim-keys.surgeon.ambiguous-family-proposal",
  "kind": "surgeon",
  "description": "Mixed-key family ambiguity produces a durable proposal instead of auto-convergence.",
  "tags": ["claim-keys", "surgeon", "proposal", "ambiguous"],
  "sandbox": {
    "reset": true,
    "preserveOnFailure": true
  },
  "setup": {
    "seedEntries": [
      {
        "id": "mixed-a",
        "type": "preference",
        "subject": "Mac mini update policy",
        "content": "The Mac mini should be updated manually.",
        "importance": 7,
        "expiry": "permanent",
        "claim_key": "mac_mini/manual_update_policy",
        "created_at": "2026-04-01T10:00:00.000Z",
        "updated_at": "2026-04-01T10:00:00.000Z"
      },
      {
        "id": "mixed-b",
        "type": "preference",
        "subject": "Mac mini update policy",
        "content": "The Mac mini update window should stay narrow.",
        "importance": 7,
        "expiry": "permanent",
        "claim_key": "mac_mini/update_window",
        "created_at": "2026-04-01T10:05:00.000Z",
        "updated_at": "2026-04-01T10:05:00.000Z"
      }
    ]
  },
  "input": {
    "pass": "claim_key_quality",
    "surgeonOptions": {
      "apply": true
    }
  },
  "expect": {
    "rows": [
      {
        "match": {
          "id": "mixed-a"
        },
        "assert": {
          "claim_key": "mac_mini/manual_update_policy"
        }
      },
      {
        "match": {
          "id": "mixed-b"
        },
        "assert": {
          "claim_key": "mac_mini/update_window"
        }
      }
    ],
    "rowCount": {
      "entries": 2,
      "activeEntries": 2,
      "entriesWithClaimKey": 2,
      "proposals": 1
    },
    "proposals": [
      {
        "match": {
          "issueKind": "mixed_claim_key_group"
        },
        "assert": {
          "issueKind": "mixed_claim_key_group",
          "scope": "cluster",
          "eligibleForApply": false
        }
      }
    ],
    "surgeonSummary": {
      "status": "completed",
      "summary": {
        "counts": {
          "proposalsEmitted": 1
        }
      }
    }
  }
}
