{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "transcriptPath",
      "type": "promptString",
      "description": "Path to transcripts for ingest entries",
      "default": "/Users/jmartin/.openclaw/sessions"
    },
    {
      "id": "episodePath",
      "type": "promptString",
      "description": "Path to transcripts or sessions directory for episode ingest",
      "default": "/Users/jmartin/.openclaw/sessions"
    },
    {
      "id": "recallQuery",
      "type": "promptString",
      "description": "Recall query",
      "default": "claim key"
    },
    {
      "id": "surgeonRunId",
      "type": "promptString",
      "description": "Surgeon run ID for surgeon actions",
      "default": "replace-me"
    },
    {
      "id": "scenarioId",
      "type": "promptString",
      "description": "Scenario ID for a single scenario run",
      "default": "replace-me"
    }
  ],
  "configurations": [
    {
      "name": "agenr: ingest entries (sandbox)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/dist/cli.js",
      "args": [
        "ingest",
        "entries",
        "${input:transcriptPath}",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "AGENR_DB_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/knowledge.db",
        "AGENR_CONFIG_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/config.json"
      },
      "preLaunchTask": "pnpm: build:debug"
    },
    {
      "name": "agenr: ingest episodes (sandbox)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/dist/cli.js",
      "args": [
        "ingest",
        "episodes",
        "${input:episodePath}",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "AGENR_DB_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/knowledge.db",
        "AGENR_CONFIG_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/config.json"
      },
      "preLaunchTask": "pnpm: build:debug"
    },
    {
      "name": "agenr: recall (sandbox)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/dist/cli.js",
      "args": [
        "recall",
        "${input:recallQuery}",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
