{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "agenr: sandbox ingest (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/dist/cli.js",
      "args": ["ingest", "/Users/jmartin/.openclaw-sandbox/.openclaw/agents/main/real_seed_sessions_2_days/", "--verbose"],
      "env": {
        "AGENR_DB_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/knowledge.db",
        "AGENR_CONFIG_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/config.json"
      },
      "preLaunchTask": "build:debug",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "agenr: sandbox ingest single file (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/dist/cli.js",
      "args": ["ingest", "${input:sessionFile}", "--verbose"],
      "env": {
        "AGENR_DB_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/knowledge.db",
        "AGENR_CONFIG_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/config.json"
      },
      "preLaunchTask": "build:debug",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "agenr: sandbox recall (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/dist/cli.js",
      "args": ["recall", "${input:recallQuery}", "--verbose"],
      "env": {
        "AGENR_DB_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/knowledge.db",
        "AGENR_CONFIG_PATH": "/Users/jmartin/.openclaw-sandbox/agenr-data/config.json"
      },
      "preLaunchTask": "build:debug",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "agenr: debug vitest current file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect-brk", "${workspaceFolder}/node_modules/vitest/vitest.mjs", "run", "${file}"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "sessionFile",
      "type": "promptString",
      "description": "Full path to a single .jsonl session file",
      "default": "/Users/jmartin/.openclaw-sandbox/.openclaw/agents/main/real_seed_sessions_2_days/"
    },
    {
      "id": "recallQuery",
      "type": "promptString",
      "description": "Recall query string",
      "default": "test query"
    }
  ]
}
